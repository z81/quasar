[Unit]
Description=GigaAM v3 E2E RNNT streaming STT gateway
After=network.target gigaam-stt.service
Wants=gigaam-stt.service

[Service]
WorkingDirectory=/root
Environment=GIGAAM_PRIMARY_URL=http://127.0.0.1:8097/inference
ExecStart=/opt/qwen-venv/bin/python /root/whisper_gigastt.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
